<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.host_app">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="hot wheels"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <!-- MainActivity has NO LAUNCHER intent-filter — prevents a duplicate icon.
             Flutter tooling still works fine; the aliases below handle launching. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <!-- ✅ Flutter tooling REQUIRES this MAIN action here -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <!-- NOTE: No LAUNCHER category here — avoids a home screen icon
                     directly from MainActivity. The aliases below are the sole
                     entry points visible to the launcher. -->
            </intent-filter>
        </activity>

        <!-- DEFAULT icon alias — ENABLED by default, this is your normal app icon.
             Only ONE alias should be enabled="true" at any given time. -->
        <activity-alias
            android:name=".DefaultIcon"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:icon="@drawable/app_icon"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Alternate icon 1 — disabled by default -->
        <activity-alias
            android:name=".IconOne"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@drawable/hot_wheels"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Alternate icon 2 — disabled by default -->
        <activity-alias
            android:name=".IconTwo"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:icon="@drawable/hot_wheels2"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Required by Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <!-- Required for Flutter's ProcessTextPlugin -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

</manifest>